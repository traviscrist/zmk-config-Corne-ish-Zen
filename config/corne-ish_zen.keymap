/*
 * Corne-ish Zen keymap based on Mark Stosberg's Corne 3x5+1 v2.2 layout.
 * https://mark.stosberg.com/markstos-corne-3x5-1-keyboard-layout/
 *
 * Independently translated to native ZMK behaviors for this board.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// Layers must match the declaration order below.
#define BASE     0
#define LOWER    1
#define RAISE    2
#define FUNCTION 3

/ {
    chosen {
        zmk,matrix_transform = &default_transform;
        // zmk,matrix_transform = &five_column_transform;
    };
};

// macOS shortcuts.
#define U_COPY     LG(C)
#define U_PSTE     LG(V)
#define U_CMD_1    LG(N1)
#define U_CMD_2    LG(N2)
#define U_CMD_3    LG(N3)
#define U_CMD_4    LG(N4)
#define U_CMD_5    LG(N5)
#define U_TAB_PREV LG(LS(LBKT))
#define U_TAB_NEXT LG(LS(RBKT))

// Mark's one-shot modifier timeout.
&sk {
    release-after-ms = <2000>;
};

// Function is available as a one-shot layer or while held.
&sl {
    release-after-ms = <2000>;
};

// Thumb layer-taps favor the layer when another key is pressed.
&lt {
    flavor = "hold-preferred";
    tapping-term-ms = <125>;
    quick-tap-ms = <0>;
};

// Thumb modifier-taps use Mark's longer general tapping term.
&mt {
    flavor = "hold-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        jk_escape {
            timeout-ms = <40>;
            key-positions = <19 20>;
            bindings = <&kp ESC>;
            layers = <BASE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
                &kp TAB    &kp Q          &kp W          &kp E      &kp R      &kp T       &kp Y     &kp U     &kp I      &kp O       &kp P     &kp DEL
                &kp CAPS   &kp A          &kp S          &kp D      &kp F      &kp G       &kp H     &kp J     &kp K      &kp L       &kp SQT   &sk RALT
                &sk LSHFT  &kp Z          &kp X          &kp C      &kp V      &kp B       &kp N     &kp M     &kp COMMA  &kp DOT     &kp FSLH  &sl FUNCTION
                                           &sk LCTRL       &mt LGUI ENTER       &lt LOWER TAB          &lt RAISE BSPC  &kp SPACE  &sk RSHFT
            >;
        };

        lower_layer {
            label = "LOWER";
            bindings = <
                &trans  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH   &kp DOLLAR        &kp PERCENT       &kp CARET        &kp AMPERSAND      &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
                &trans  &kp N1           &kp N2       &kp N3     &kp N4            &kp N5            &kp N6           &kp N7             &kp N8        &kp N9                  &kp N0                   &trans
                &trans  &none            &kp TILDE    &kp GRAVE  &kp LEFT_BRACKET  &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp COMMA     &kp DOT                 &kp FSLH                 &trans
                                                     &trans       &trans            &trans             &trans             &trans       &kp COLON
            >;
        };

        raise_layer {
            label = "RAISE";
            bindings = <
                &trans  &kp U_CMD_1    &kp U_CMD_2       &kp U_CMD_3     &kp U_CMD_4  &kp U_CMD_5    &kp U_TAB_PREV  &kp U_TAB_NEXT  &none       &kp BSLH      &kp PIPE      &trans
                &trans  &kp HOME       &kp END           &kp MINUS       &kp EQUAL  &kp PG_DN      &kp LEFT  &kp DOWN    &kp UP     &kp RIGHT     &kp K_APP     &trans
                &trans  &kp LESS_THAN  &kp GREATER_THAN  &kp U_COPY      &kp U_PSTE &kp SEMI       &kp C_PP  &kp C_PREV  &kp C_NEXT &kp C_VOL_DN  &kp C_VOL_UP  &trans
                                                      &mt LCTRL ESC       &trans      &none          &trans       &trans       &trans
            >;
        };

        function_layer {
            label = "FUNCTION";
            bindings = <
                &kp F1      &kp F2        &kp F3        &kp F4        &kp F5        &kp F6        &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
                &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none   &none   &none   &none    &none    &none
                &none       &kp CAPS      &none         &none         &none         &none         &none   &none   &none   &none    &reset   &none
                                                        &none         &none         &none         &none   &none   &none
            >;
        };
    };
};
